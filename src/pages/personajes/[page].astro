---
import { marvelCharacters } from "../../data/data.ts";
import type { GetStaticPaths, Page } from "astro";
import type { Hero } from "../../types/Hero";
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Header from "../../components/personajes/Header.astro";
import Grid from "../../components/personajes/Grid.astro";
import PaginationNav from "../../components/personajes/Nav.astro";

interface Props {
  page: Page<Hero>;
}

export const getStaticPaths = (({ paginate }) => {
  return paginate(marvelCharacters, { pageSize: 10 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<Layout
  title={`Personajes | Página ${page.currentPage}`}
  description="Personajes de Marvel"
  keywords="Personajes, Marvel, Grupo 124"
>
  <Nav />
  <main
    class="min-h-[calc(100vh-60px)] bg-black/85 px-4 py-10 sm:px-6 sm:py-14"
  >
    <section
      aria-labelledby="characters-title"
      class="mx-auto w-full max-w-5xl"
    >
      <Header page={page} />
      <Grid characters={page.data} />
      <PaginationNav page={page} />
    </section>
  </main>
</Layout>
