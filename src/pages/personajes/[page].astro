---
import { marvelCharacters } from "../../data/data.ts";
import type { GetStaticPaths } from "astro";
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";

export const getStaticPaths = (({ paginate }) => {
  return paginate(marvelCharacters, { pageSize: 10 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<Layout
  title={`Personajes | Página ${page.currentPage}`}
  description="Personajes de Marvel"
  keywords="Personajes, Marvel, Grupo 124"
>
  <Nav />
  <main
    class="min-h-[calc(100vh-60px)] bg-black/85 px-4 py-10 sm:px-6 sm:py-14"
  >
    <section
      aria-labelledby="characters-title"
      class="mx-auto w-full max-w-5xl"
    >
      <header class="mb-4 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="mb-2 text-sm tracking-[0.25em] text-red-400">
            Universo Marvel
          </p>
          <h1
            id="characters-title"
            class="text-4xl tracking-wide text-white sm:text-5xl"
          >
            Personajes
          </h1>
        </div>
        <p class="text-base tracking-wide text-white/70">
          {page.start + 1}–{page.end + 1} de {page.total} personajes
        </p>
      </header>

      <ul role="list" class="grid grid-cols-2 gap-4 sm:grid-cols-5 sm:gap-5">
        {
          page.data.map((hero, index) => (
            <a href={`/heroe/${hero.slug}`}>
              <li class="group flex min-w-0 flex-col overflow-hidden rounded-lg border border-white/15 bg-white shadow-lg transition-colors hover:border-red-500">
                <div class="aspect-4/5 overflow-hidden bg-zinc-900">
                  <img
                    src={hero.image}
                    alt={hero.name}
                    loading={index < 5 ? "eager" : "lazy"}
                    class="h-full w-full object-cover motion-safe:transition-transform motion-safe:duration-300 motion-safe:group-hover:scale-105"
                  />
                </div>
                <div class="flex-1 border-t-4 border-red-600 px-3 py-3">
                  <h2 class="wrap-break-word text-lg leading-tight text-zinc-900">
                    {hero.name}
                  </h2>
                  <p class="mt-1 wrap-break-word text-sm text-zinc-600">
                    {hero.biography.fullName}
                  </p>
                </div>
              </li>
            </a>
          ))
        }
      </ul>

      <nav
        aria-label="Paginación de personajes"
        class="mt-8 flex flex-wrap items-center justify-center gap-3 pt-6"
      >
        {
          page.url.prev ? (
            <a
              href={page.url.prev}
              rel="prev"
              class="inline-flex min-h-11 items-center rounded-md border border-white/25 px-4 text-white transition-colors hover:border-red-500 hover:bg-red-600 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-red-400"
            >
              <span aria-hidden="true" class="mr-2">
                ←
              </span>{" "}
              Anterior
            </a>
          ) : (
            <span
              aria-disabled="true"
              class="inline-flex min-h-11 items-center rounded-md border border-white/10 px-4 text-white/35"
            >
              <span aria-hidden="true" class="mr-2">
                ←
              </span>{" "}
              Anterior
            </span>
          )
        }
        <p class="px-2 text-sm tracking-wide text-white/70">
          Página <span class="text-white">{page.currentPage}</span> de {
            page.lastPage
          }
        </p>
        {
          page.url.next ? (
            <a
              href={page.url.next}
              rel="next"
              class="inline-flex min-h-11 items-center rounded-md border border-white/25 px-4 text-white transition-colors hover:border-red-500 hover:bg-red-600 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-red-400"
            >
              Siguiente{" "}
              <span aria-hidden="true" class="ml-2">
                →
              </span>
            </a>
          ) : (
            <span
              aria-disabled="true"
              class="inline-flex min-h-11 items-center rounded-md border border-white/10 px-4 text-white/35"
            >
              Siguiente{" "}
              <span aria-hidden="true" class="ml-2">
                →
              </span>
            </span>
          )
        }
      </nav>
    </section>
  </main>
</Layout>
