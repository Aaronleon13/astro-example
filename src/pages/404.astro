---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="404 | Página no encontrada"
  description="Esta página no está disponible. Vuelve al inicio o explora los personajes del universo Marvel."
  keywords="404, Página no encontrada, Marvel, Grupo 124"
>
  <div class="grid min-h-dvh grid-rows-[auto_1fr_auto]">
    <Nav />
    <main
      class="flex items-center justify-center bg-black/90 px-4 py-12 text-center text-white sm:px-6"
    >
      <div class="mx-auto flex w-full max-w-xl flex-col items-center">
        <p class="text-sm tracking-[0.25em] text-zinc-400">
          Página no encontrada
        </p>
        <h1 class="mt-4 text-9xl leading-none text-red-500 sm:text-[12rem]">
          <span class="sr-only">Error </span>404
        </h1>
        <h2 class="mt-4 text-3xl leading-tight sm:text-4xl">
          Esta página se perdió en el multiverso.
        </h2>
        <p
          class="mx-auto mt-4 max-w-md text-base leading-relaxed text-zinc-400 sm:text-lg"
        >
          El enlace puede haber cambiado o la página que buscas no existe.
          Regresa al inicio para continuar tu aventura.
        </p>
        <div class="mt-8 flex w-full max-w-sm flex-col justify-center gap-3 sm:w-auto sm:max-w-none sm:flex-row">
          <a
            href="/"
            class="inline-flex min-h-12 items-center justify-center rounded-md bg-red-600 px-10 py-3 text-lg tracking-wide transition-colors hover:bg-red-700 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white sm:px-12"
          >
            Volver al inicio
          </a>
          <a
            href="/personajes/1/"
            class="inline-flex min-h-12 items-center justify-center rounded-md border border-white/25 px-10 py-3 text-lg tracking-wide transition-colors hover:border-white/60 hover:bg-white/5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white sm:px-12"
          >
            Explorar personajes
          </a>
        </div>
      </div>
    </main>
    <Footer />
  </div>
</Layout>
