---
const imagePath = (file: string) => `/images/heroes/${file}`;

const items = [
  { image: imagePath("deadpool.webp"), alt: "Deadpool" },
  { image: imagePath("groot.webp"), alt: "Groot" },
  { image: imagePath("gamora.webp"), alt: "Gamora" },
  { image: imagePath("wolverine.webp"), alt: "Wolverine" },
];
---

<section class="w-full min-h-[60vh] bg-white/80 flex justify-center py-5">
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-10 max-w-4xl w-full p-2">
    <div
      class="grid grid-cols-2 rounded-3xl overflow-hidden drop-shadow-2xl drop-shadow-black order-2 sm:order-1"
    >
      {
        items.map((item) => (
          <button
            type="button"
            data-image-toggle
            aria-label={`Resaltar a ${item.alt}`}
            aria-pressed="false"
            class="group w-full overflow-hidden touch-manipulation focus-visible:outline-4 focus-visible:-outline-offset-4 focus-visible:outline-red-600"
          >
            <img
              src={item.image}
              alt={item.alt}
              class="w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-150 group-focus-visible:grayscale-0 group-focus-visible:scale-150 group-aria-pressed:grayscale-0 group-aria-pressed:scale-150 transition-all duration-500 ease-linear motion-reduce:transition-none"
            />
          </button>
        ))
      }
    </div>
    <div class="flex flex-col justify-center order-1 sm:order-2">
      <h3 class="text-black text-6xl">Descubre toda la información</h3>
      <p class="text-black">
        Conoce todo sobre los Vengadores, sus poderes, habilidades y más.
      </p>
      <a
        href="/personajes/1/"
        class="bg-red-500 text-white p-2 w-32 text-center rounded-md hover:opacity-80 transition-opacity"
        >Explorar Heroes</a
      >
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-image-toggle]").forEach((button) => {
    button.addEventListener("click", () => {
      button.setAttribute("aria-pressed", String(button.getAttribute("aria-pressed") !== "true"));
    });
  });
</script>
