---
import type { Hero } from "../../types/Hero";

interface Props {
  stats: Hero["powerstats"];
}

const { stats } = Astro.props;
const labels = {
  intelligence: "Inteligencia",
  strength: "Fuerza",
  speed: "Velocidad",
  durability: "Resistencia",
  power: "Poder",
  combat: "Combate",
} satisfies Record<keyof Hero["powerstats"], string>;
const keys = Object.keys(labels) as (keyof typeof labels)[];
---

<section aria-labelledby="stats-title" class="border-t border-zinc-200 pt-6">
  <div class="flex items-baseline justify-between gap-4">
    <h2 id="stats-title" class="text-2xl tracking-wide">Estadísticas</h2>
    <span class="font-sans text-xs text-zinc-500">Escala de 0 a 100</span>
  </div>
  <div class="mt-5 grid gap-x-8 gap-y-5 sm:grid-cols-2">
    {
      keys.map((key) => {
        const value = stats[key];
        const hasValue = typeof value === "number" && Number.isFinite(value);
        const normalizedValue = hasValue ? Math.min(100, Math.max(0, value)) : 0;

        return (
          <div class="font-sans text-sm">
            <div class="mb-2 flex items-center justify-between gap-3">
              <span id={`stat-${key}`} class="text-zinc-600">{labels[key]}</span>
              <span class="text-xs font-medium tabular-nums text-zinc-900">
                {hasValue ? normalizedValue : "Sin datos"}
              </span>
            </div>
            {hasValue && (
              <meter
                min="0"
                max="100"
                value={normalizedValue}
                data-animate-stat
                data-value={normalizedValue}
                aria-labelledby={`stat-${key}`}
                class="stat-meter"
              >
                {normalizedValue} de 100
              </meter>
            )}
          </div>
        );
      })
    }
  </div>
</section>

<script>
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (!reducedMotion.matches && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting || !(entry.target instanceof HTMLMeterElement)) {
            continue;
          }

          const meter = entry.target;
          const target = Number(meter.dataset.value);
          let startedAt: number | undefined;

          observer.unobserve(meter);

          const animate = (timestamp: number) => {
            startedAt ??= timestamp;
            const progress = reducedMotion.matches
              ? 1
              : Math.min((timestamp - startedAt) / 1000, 1);
            const easedProgress = 1 - Math.pow(1 - progress, 3);

            meter.value = target * easedProgress;

            if (progress < 1) {
              requestAnimationFrame(animate);
            }
          };

          requestAnimationFrame(animate);
        }
      },
      { threshold: 0.5 },
    );

    document.querySelectorAll("meter[data-animate-stat]").forEach((meter) => {
      if (meter instanceof HTMLMeterElement) {
        meter.value = 0;
        observer.observe(meter);
      }
    });
  }
</script>

<style>
  .stat-meter {
    display: block;
    width: 100%;
    height: 5px;
    overflow: hidden;
    border: 0;
    border-radius: 999px;
    background: #e4e4e7;
  }

  .stat-meter::-webkit-meter-bar {
    height: 5px;
    border: 0;
    border-radius: 999px;
    background: #e4e4e7;
  }

  .stat-meter::-webkit-meter-optimum-value {
    border-radius: 999px;
    background: #dc2626;
  }

  .stat-meter::-moz-meter-bar {
    border-radius: 999px;
    background: #dc2626;
  }
</style>
