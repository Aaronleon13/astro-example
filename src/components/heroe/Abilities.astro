---
interface Props {
  abilities: string[];
}

const { abilities } = Astro.props;
---

{
  abilities.length > 0 && (
    <section
      aria-labelledby="abilities-title"
      class="border-t border-zinc-200 pt-6"
    >
      <h2 id="abilities-title" class="text-2xl tracking-wide">
        Habilidades
      </h2>
      <ul
        role="list"
        class="mt-4 flex flex-wrap gap-2 font-sans text-sm text-zinc-600"
      >
        {abilities.map((ability) => (
          <li class="rounded-md border border-red-600 px-3 py-2">{ability}</li>
        ))}
      </ul>
    </section>
  )
}
