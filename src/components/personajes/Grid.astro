---
import type { Hero } from "../../types/Hero";
import Card from "./Card.astro";

interface Props {
  characters: Hero[];
}

const { characters } = Astro.props;
---

<ul role="list" class="grid grid-cols-2 gap-4 sm:grid-cols-5 sm:gap-5">
  {
    characters.map((hero, index) => (
      <Card hero={hero} loading={index < 5 ? "eager" : "lazy"} />
    ))
  }
</ul>
