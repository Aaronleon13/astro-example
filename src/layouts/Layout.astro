---
import "../styles/global.css";

const imagePath = (file: string) => `/images/${file}`; // Esta es una funcion de flecha
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro Basics</title>
  </head>
  <body
    style={`background-image: url(${imagePath("bg-home.webp")})`}
    class="bg-auto bg-center bg-repeat"
  >
    <slot />
  </body>
</html>
